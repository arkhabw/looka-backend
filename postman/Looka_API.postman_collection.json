    {
      "name": "3. Outfit Recommender & Lookbook",
      "item": [
        {
          "name": "Generate Outfit Recommendations (POST with filters)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"occasion\": \"Casual Hangout\",\n  \"lockedItemId\": null,\n  \"city\": \"Jakarta\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/recommendations",
              "host": ["{{base_url}}"],
              "path": ["recommendations"]
            }
          },
          "response": []
        },
        {
          "name": "Get Outfit Recommendations (GET quick / query params)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/recommendations?occasion=Casual%20Hangout&city=Jakarta",
              "host": ["{{base_url}}"],
              "path": ["recommendations"],
              "query": [
                {
                  "key": "occasion",
                  "value": "Casual Hangout"
                },
                {
                  "key": "city",
                  "value": "Jakarta"
                },
                {
                  "key": "lockedItemId",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Saved Outfit (Lookbook)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Signature Streetwear\",\n  \"topId\": 1,\n  \"bottomId\": 2,\n  \"outerId\": null,\n  \"footwearId\": 4,\n  \"occasion\": \"Casual Hangout\",\n  \"isFavorite\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/outfits",
              "host": ["{{base_url}}"],
              "path": ["outfits"]
            }
          },
          "response": []
