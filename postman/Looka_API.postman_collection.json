    {
      "name": "2. Smart Wardrobe (Clothes)",
      "item": [
        {
          "name": "Get Filter Metadata (Categories, Colors, Styles)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/clothes/meta/filters",
              "host": ["{{base_url}}"],
              "path": ["clothes", "meta", "filters"]
            }
          },
          "response": []
        },
        {
          "name": "Get User Clothes (with Filter, Search & Sorting)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/clothes?category=Tops&color=Navy&style=Casual&search=Kemeja&sortBy=newest",
              "host": ["{{base_url}}"],
              "path": ["clothes"],
              "query": [
                { "key": "category", "value": "Tops" },
                { "key": "color", "value": "Navy" },
                { "key": "style", "value": "Casual" },
                { "key": "occasion", "value": "Casual Hangout" },
                { "key": "search", "value": "Kemeja" },
                { "key": "sortBy", "value": "newest" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload & Create Clothing Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
