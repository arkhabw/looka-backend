            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Kemeja Oxford Navy", "type": "text" },
                { "key": "category", "value": "Tops", "type": "text" },
                { "key": "color", "value": "Navy", "type": "text" },
                { "key": "style", "value": "Smart Casual", "type": "text" },
                { "key": "occasion", "value": "Work/Campus", "type": "text" },
                { "key": "weather", "value": "All Weather", "type": "text" },
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{base_url}}/clothes",
              "host": ["{{base_url}}"],
              "path": ["clothes"]
            }
          },
          "response": []
