            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/outfits?isFavorite=true",
              "host": ["{{base_url}}"],
              "path": ["outfits"],
              "query": [
                {
                  "key": "isFavorite",
                  "value": "true"
